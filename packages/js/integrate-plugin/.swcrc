{
	"$schema": "https://json.schemastore.org/swcrc",
	"jsc": {
		"parser": {
			"syntax": "typescript",
			"tsx": true
		},
		"target": "esnext",
		"transform": {
			"react": {
				"runtime": "classic",
				"pragma": "createElement",
				"pragmaFrag": "Fragment"
			}
		}
	},
	"module": {
		"type": "commonjs",
		"noInterop": false
	},
	"test": "\\.(ts|tsx|js|jsx)$",
	"exclude": [
		"/test/",
		"/stories/"
	]
}
