{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"@woocommerce-settings-ui-experimental/settings-ui": [
				"./packages/settings-ui/src/index.tsx"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/fields/**/*",
		"routes/**/*"
	]
}
