{
	"name": "@woocommerce/settings-dataform",
	"version": "0.0.0",
	"description": "Development scaffold for a WooCommerce Settings DataForm page.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "wp-build",
		"build:core": "node build-core.mjs",
		"lint:types": "tsc --noEmit",
		"start": "wp-build --watch",
		"watch:core": "node build-core.mjs --watch"
	},
	"devDependencies": {
		"@types/react": "18.3.x",
		"@wordpress/build": "catalog:tooling",
		"typescript": "5.7.x"
	},
	"wpPlugin": {
		"name": "woocommerce_settings_ui_experimental",
		"scriptGlobal": false,
		"packageNamespace": "woocommerce-settings-ui-experimental",
		"handlePrefix": "wc-settings-ui-experimental",
		"pages": [
			{
				"id": "wc-settings-dataform",
				"capability": "manage_woocommerce"
			}
		]
	}
}
