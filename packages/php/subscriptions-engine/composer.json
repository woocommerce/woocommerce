{
	"name": "woocommerce/subscriptions-engine",
	"description": "Subscriptions engine for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"version": "0.0.1",
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/unit/"
		]
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"woocommerce/woocommerce-sniffs": "1.0.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"post-install-cmd": [
			"composer dump-autoload -o"
		],
		"post-update-cmd": [
			"composer dump-autoload -o"
		],
		"phpcs": "phpcs -s -p",
		"phpcbf": "phpcbf -p"
	}
}
