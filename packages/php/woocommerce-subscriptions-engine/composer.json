{
	"name": "automattic/woocommerce-subscriptions-engine",
	"description": "Subscriptions engine for WooCommerce: plans, contracts, and renewal machinery as a reusable package.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"version": "0.0.1",
	"autoload": {
		"psr-4": {
			"Automattic\\WooCommerce\\SubscriptionsEngine\\": "src/"
		}
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"automattic/jetpack-changelogger": "3.3.0"
	},
	"config": {
		"platform": {
			"php": "7.4"
		}
	},
	"extra": {
		"changelogger": {
			"formatter": {
				"filename": "../../../tools/changelogger/class-php-package-formatter.php"
			},
			"types": {
				"fix": "Fixes an existing bug",
				"add": "Adds functionality",
				"update": "Update existing functionality",
				"dev": "Development related task",
				"tweak": "A minor adjustment to the codebase",
				"performance": "Address performance issues",
				"enhancement": "Improve existing functionality"
			},
			"changelog": "changelog.md"
		}
	}
}
