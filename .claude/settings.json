{
  "description": "Default Claude Code settings for the WooCommerce repository",
  "permissions": {
    "allow": [
      "Skill(woocommerce-backend-dev)",
      "Skill(woocommerce-code-review)",
      "Skill(woocommerce-copy-guidelines)",
      "Skill(woocommerce-dev-cycle)",
      "Skill(woocommerce-markdown)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx block-no-verify@1.1.2"
          }
        ]
      }
    ]
  }
}
