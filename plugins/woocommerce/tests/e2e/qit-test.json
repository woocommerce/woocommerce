{
    "$schema": "https://qit.woo.com/json-schema/test-package",
    "package": "woocommerce/e2e",
    "test_type": "e2e",
    "description": "WooCommerce E2E test suite ported to QIT test package format",
    "tags": ["e2e", "woocommerce", "checkout", "cart", "products"],
    "requires": {
    		"network": true
    },
    "mu_plugins": [
        "./bin/filter-setter.php",
        "./bin/process-waiting-actions.php",
        "./bin/test-helper-apis.php",
        "./bin/woocommerce-cleanup.php"
    ],
    "test": {
        "phases": {
            "globalSetup": [
                "./bootstrap/global-setup.sh",
                {
                    "command": "npx playwright test --config=playwright.bootstrap.config.js dismiss-coming-soon.spec.js",
                    "runs_on": "host"
                }
            ],
            "setup": [
                "./bootstrap/setup.sh",
                {
                    "command": "./bin/copy-images-to-container.sh",
                    "runs_on": "host"
                }
            ],
            "run": ["npx playwright test --project=e2e"],
            "teardown": [],
            "globalTeardown": ["./bootstrap/global-teardown.sh"]
        },
        "results": {
            "ctrf-json": "./results/ctrf.json",
            "allure-dir": "./results/allure",
            "blob-dir": "./results/blob"
        }
    },
    "subpackages": {
        "woocommerce/api": {
            "description": "WooCommerce API test suite",
            "tags": ["api", "woocommerce", "rest-api"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=api"]
                }
            }
        },
        "woocommerce/shopper": {
            "description": "Complete shopper journey tests - cart, checkout, shop browsing, and account management",
            "tags": ["shopper", "e2e", "critical-path", "frontend"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/cart/ tests/checkout/ tests/shop/ tests/my-account/"]
                }
            }
        },
        "woocommerce/shopper-checkout": {
            "description": "Focused checkout flow testing - guest and logged-in checkout scenarios",
            "tags": ["shopper", "checkout", "payments", "critical-path"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/checkout/ tests/coupons/"]
                }
            }
        },
        "woocommerce/merchant-products": {
            "description": "Product management tests - creation, editing, import/export, inventory",
            "tags": ["merchant", "products", "admin", "backend"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/product/"]
                }
            }
        },
        "woocommerce/merchant-orders": {
            "description": "Order management tests - creation, editing, refunds, status management",
            "tags": ["merchant", "orders", "admin", "backend"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/order/"]
                }
            }
        },
        "woocommerce/merchant-store": {
            "description": "Store configuration tests - settings, shipping, taxes, analytics",
            "tags": ["merchant", "settings", "admin", "configuration"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/settings/ tests/shipping/ tests/analytics/"]
                }
            }
        },
        "woocommerce/blocks": {
            "description": "Block functionality tests - cart/checkout blocks, product blocks, block editor",
            "tags": ["blocks", "gutenberg", "frontend", "editor"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/product/block-editor/ tests/coupons/cart-block-coupons.spec.js"]
                }
            }
        },
        "woocommerce/mini-cart": {
            "description": "Mini-cart specific tests - add to cart interactions, mini-cart display",
            "tags": ["mini-cart", "shopper", "frontend", "blocks"],
            "test": {
                "phases": {
                    "run": ["npx playwright test --project=e2e tests/cart/add-to-cart.spec.js"]
                }
            }
        }
    }
}
