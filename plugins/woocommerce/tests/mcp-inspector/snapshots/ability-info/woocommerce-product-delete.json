{
	"name": "woocommerce/product-delete",
	"label": "Delete product",
	"description": "Delete, trash, or restore a product.",
	"input_schema": {
		"type": "object",
		"properties": {
			"id": {
				"type": "integer",
				"minimum": 1
			},
			"force": {
				"type": "boolean",
				"description": "Permanently delete the product. Defaults to false, which moves the product to trash.",
				"default": false
			}
		},
		"required": [
			"id"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"deleted": {
				"type": "boolean"
			},
			"id": {
				"type": "integer"
			}
		},
		"additionalProperties": false
	},
	"meta": {
		"annotations": {
			"readonly": false,
			"destructive": true,
			"idempotent": true
		},
		"show_in_rest": true,
		"mcp": {
			"public": true,
			"type": "tool"
		},
		"public": false
	}
}
