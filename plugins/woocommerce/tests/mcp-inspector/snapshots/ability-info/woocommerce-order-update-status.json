{
	"name": "woocommerce/order-update-status",
	"label": "Update order status",
	"description": "Update an order status.",
	"input_schema": {
		"type": "object",
		"properties": {
			"id": {
				"type": "integer",
				"minimum": 1
			},
			"status": {
				"type": "string",
				"description": "Order status slug without the wc- prefix. Custom order types may add their own statuses.",
				"enum": [
					"pending",
					"processing",
					"on-hold",
					"completed",
					"cancelled",
					"refunded",
					"failed"
				]
			},
			"note": {
				"type": "string",
				"description": "Optional status change note. Safe HTML is allowed. Use the woocommerce/order-add-note ability for notes without a status change."
			}
		},
		"required": [
			"id",
			"status"
		],
		"additionalProperties": false
	},
