								"PKR",
								"PLN",
								"PRB",
								"PYG",
								"QAR",
								"RON",
								"RSD",
								"RUB",
								"RWF",
								"SAR",
								"SBD",
								"SCR",
								"SDG",
								"SEK",
								"SGD",
								"SHP",
								"SLL",
								"SOS",
								"SRD",
								"SSP",
								"STN",
								"SYP",
								"SZL",
								"THB",
								"TJS",
