{
	"name": "woocommerce/products-query",
	"label": "Query products",
	"description": "Find products by ID or common catalog filters.",
	"input_schema": {
		"type": "object",
		"properties": {
			"id": {
				"type": "integer",
				"minimum": 1
			},
			"search": {
				"type": "string"
			},
			"sku": {
				"type": "string",
				"description": "Limit results to products with SKUs that partially match this string. Use * to match products with any non-empty SKU."
			},
			"status": {
				"type": "string",
				"enum": [
					"future",
					"trash",
					"draft",
					"pending",
					"private",
					"publish"
				]
			},
			"type": {
				"type": "string",
				"description": "Product type, from the product types that WooCommerce and extensions register.",
				"enum": [
					"simple",
					"grouped",
					"external",
					"variable"
				]
			},
			"virtual": {
				"type": "boolean",
				"description": "Limit results to products that are not shipped (true) or that are shipped (false)."
			},
			"downloadable": {
				"type": "boolean",
				"description": "Limit results to products that have files to download (true) or that do not (false)."
			},
			"stock_status": {
				"type": "string",
				"enum": [
					"instock",
					"outofstock",
					"onbackorder"
				]
			},
			"page": {
				"type": "integer",
				"default": 1,
				"minimum": 1
			},
			"per_page": {
				"type": "integer",
				"default": 10,
				"minimum": 1,
				"maximum": 100
			}
		},
		"additionalProperties": false,
		"default": []
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"products": {
				"type": "array",
				"description": "Returned products for the current page.",
				"items": {
					"type": "object",
					"properties": {
						"id": {
							"type": "integer"
						},
						"name": {
							"type": "string"
						},
						"slug": {
							"type": "string"
						},
						"permalink": {
							"type": [
								"string",
								"null"
							],
							"description": "Product permalink, or null when no public permalink is available.",
							"format": "uri"
						},
						"type": {
							"type": "string",
							"description": "Internal product type slug, such as simple, external, grouped, or variable.",
							"enum": [
								"simple",
								"grouped",
								"external",
								"variable"
							]
						},
						"status": {
							"type": "string",
