{
	"name": "woocommerce/product-create",
	"label": "Create product",
	"description": "Create a product using supported catalog fields.",
	"input_schema": {
		"type": "object",
		"properties": {
			"type": {
				"type": "string",
				"description": "Product type, from the product types that WooCommerce and extensions register. Fields each type takes. simple: name, sku, description, short_description, status, virtual, downloadable, regular_price, sale_price, manage_stock, stock_quantity, stock_status; grouped: name, sku, description, short_description, status, grouped_products; external: name, sku, description, short_description, status, regular_price, sale_price, external_url, button_text. A product without a type is simple.",
				"enum": [
					"simple",
					"grouped",
					"external"
				],
				"default": "simple"
			},
			"name": {
				"type": "string"
			},
			"sku": {
				"type": "string"
			},
			"regular_price": {
				"type": "string",
				"description": "Decimal price as a string, without a currency symbol or thousand separators. Applies to: simple, external.",
				"pattern": "^(?:-?(?:[0-9]+(?:[\\.][0-9]+)?|[\\.][0-9]+)|)$"
			},
			"sale_price": {
				"type": "string",
				"description": "Decimal price as a string, without a currency symbol or thousand separators. Applies to: simple, external.",
				"pattern": "^(?:-?(?:[0-9]+(?:[\\.][0-9]+)?|[\\.][0-9]+)|)$"
			},
			"description": {
				"type": "string",
				"description": "Product description content. Safe HTML is allowed."
			},
			"short_description": {
				"type": "string",
				"description": "Short product description content. Safe HTML is allowed."
			},
			"status": {
				"type": "string",
				"enum": [
					"draft",
					"pending",
					"private",
					"publish",
					"future"
				]
			},
			"virtual": {
				"type": "boolean",
				"description": "Whether the product is not shipped. Applies to: simple."
			},
			"downloadable": {
				"type": "boolean",
				"description": "Whether the product gives the customer files to download. Applies to: simple."
			},
			"manage_stock": {
				"type": "boolean",
				"description": "Applies to: simple."
			},
			"stock_quantity": {
				"type": "integer",
				"description": "Available stock quantity when product-level stock management is used. Applies to: simple."
			},
			"stock_status": {
				"type": "string",
				"enum": [
					"instock",
					"outofstock",
					"onbackorder"
				],
				"description": "Applies to: simple."
			},
			"external_url": {
				"type": "string",
				"description": "External destination URL for external products. Applies to: external.",
				"format": "uri"
			},
			"button_text": {
				"type": "string",
				"description": "Button text for external products. Applies to: external."
			},
			"grouped_products": {
				"type": "array",
				"description": "Product IDs to include as children of a grouped product. Applies to: grouped.",
				"items": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"required": [
			"name"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"product": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer"
					},
					"name": {
						"type": "string"
					},
					"slug": {
