{
	"name": "woocommerce/orders-query",
	"label": "Query orders",
	"description": "Find orders by ID or common order filters.",
	"input_schema": {
		"type": "object",
		"properties": {
			"id": {
				"type": "integer",
				"minimum": 1
			},
			"type": {
				"type": "string",
				"description": "Order type to list. Extensions can register more order types. Defaults to shop_order.",
				"enum": [
					"shop_order"
				],
				"default": "shop_order"
			},
			"status": {
				"description": "Filter by one order status slug, or a list of slugs, without the wc- prefix. Custom order types may add their own statuses.",
				"anyOf": [
					{
						"type": "string",
						"enum": [
							"pending",
							"processing",
							"on-hold",
							"completed",
							"cancelled",
							"refunded",
							"failed"
						]
					},
					{
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"pending",
								"processing",
								"on-hold",
								"completed",
								"cancelled",
								"refunded",
								"failed"
							]
						}
					}
				]
			},
			"customer_id": {
				"type": "integer",
				"description": "Filter by customer ID. Use 0 to filter guest orders.",
				"minimum": 0
			},
			"billing_email": {
				"type": "string",
				"format": "email"
			},
			"parent": {
				"type": "integer",
				"description": "Filter by parent order ID.",
				"minimum": 1
			},
			"exclude": {
				"type": "array",
				"description": "Order IDs to exclude from the results.",
				"items": {
					"type": "integer",
					"minimum": 1
				}
			},
			"date_after": {
				"type": "string",
				"description": "Filter orders created after this date and time, in ISO 8601 format. A value without a UTC offset, such as 2025-07-15T10:00:00, is in the store timezone. Add Z or an offset such as +02:00 to use another timezone.",
				"format": "date-time"
			},
			"date_before": {
				"type": "string",
				"description": "Filter orders created before this date and time, in ISO 8601 format. A value without a UTC offset, such as 2025-07-15T10:00:00, is in the store timezone. Add Z or an offset such as +02:00 to use another timezone.",
				"format": "date-time"
			},
			"modified_after": {
				"type": "string",
				"description": "Filter orders modified after this date and time, in ISO 8601 format. A value without a UTC offset, such as 2025-07-15T10:00:00, is in the store timezone. Add Z or an offset such as +02:00 to use another timezone.",
				"format": "date-time"
			},
			"modified_before": {
				"type": "string",
				"description": "Filter orders modified before this date and time, in ISO 8601 format. A value without a UTC offset, such as 2025-07-15T10:00:00, is in the store timezone. Add Z or an offset such as +02:00 to use another timezone.",
				"format": "date-time"
			},
			"orderby": {
				"type": "string",
				"enum": [
					"id",
					"date",
					"date_modified",
					"total"
				]
			},
			"order": {
				"type": "string",
				"enum": [
					"asc",
					"desc"
				]
			},
			"include_line_items": {
				"type": "boolean",
				"description": "Whether to include order line items in each returned order. Defaults to false.",
				"default": false
			},
			"page": {
				"type": "integer",
				"default": 1,
				"minimum": 1
			},
			"per_page": {
				"type": "integer",
				"default": 10,
				"minimum": 1,
				"maximum": 100
			}
		},
		"additionalProperties": false,
		"default": []
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"orders": {
				"type": "array",
				"description": "Returned orders for the current page.",
				"items": {
					"type": "object",
