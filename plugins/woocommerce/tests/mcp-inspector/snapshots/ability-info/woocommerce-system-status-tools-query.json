{
	"name": "woocommerce/system-status-tools-query",
	"label": "Query status tools",
	"description": "List the maintenance tools under WooCommerce > Status > Tools, in screen order, and what each does. Run a runnable one with woocommerce/system-status-tool-run.",
	"input_schema": {
		"type": "object",
		"properties": {
			"include": {
				"type": "array",
				"description": "Return only these tool IDs.",
				"items": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"additionalProperties": false,
		"default": []
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"tools": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"id": {
							"type": "string"
						},
						"name": {
							"type": "string"
						},
						"description": {
							"type": "string"
						},
						"runnable": {
							"type": "boolean",
							"description": "Whether woocommerce/system-status-tool-run can run the tool."
						}
					},
					"additionalProperties": false
				}
			}
		},
		"additionalProperties": false
	},
	"meta": {
		"annotations": {
			"readonly": true,
			"destructive": false,
			"idempotent": true
		},
		"show_in_rest": true,
		"mcp": {
			"public": true,
			"type": "tool"
		},
		"public": false
	}
}
