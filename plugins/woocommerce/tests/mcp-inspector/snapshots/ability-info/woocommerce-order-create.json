{
	"name": "woocommerce/order-create",
	"label": "Create order",
	"description": "Create an order, as the order screen does, for example for a phone order. Without customer_id, the order is a guest order. Without status, the order gets the default status of the store, which is pending payment unless an extension changes it. A processing, on-hold or completed status reduces the stock of the products and sends the order emails to the store and the customer, so confirm the status before you send it.",
	"input_schema": {
		"type": "object",
		"properties": {
			"customer_id": {
				"type": "integer",
				"minimum": 1
			},
			"status": {
				"type": "string",
				"description": "Order status slug without the wc- prefix. Defaults to the default status of the store.",
				"enum": [
					"pending",
					"processing",
					"on-hold",
					"completed",
					"cancelled",
					"refunded",
					"failed"
				]
			},
			"billing": {
				"type": "object",
				"description": "Countries use ISO 3166-1 alpha-2 codes, and states use WooCommerce state codes.",
				"properties": {
					"first_name": {
						"type": "string"
					},
					"last_name": {
						"type": "string"
					},
					"company": {
						"type": "string"
					},
					"address_1": {
						"type": "string"
					},
					"address_2": {
						"type": "string"
					},
					"city": {
						"type": "string"
					},
					"state": {
						"type": "string"
					},
					"postcode": {
						"type": "string"
					},
					"country": {
						"type": "string"
					},
					"phone": {
						"type": "string"
					},
					"email": {
						"type": "string"
					}
				},
				"additionalProperties": false,
				"minProperties": 1
			},
			"shipping": {
				"type": "object",
				"description": "Countries use ISO 3166-1 alpha-2 codes, and states use WooCommerce state codes.",
				"properties": {
					"first_name": {
						"type": "string"
					},
					"last_name": {
						"type": "string"
					},
					"company": {
						"type": "string"
					},
					"address_1": {
						"type": "string"
					},
					"address_2": {
						"type": "string"
					},
					"city": {
						"type": "string"
					},
					"state": {
						"type": "string"
					},
					"postcode": {
						"type": "string"
					},
					"country": {
						"type": "string"
					},
					"phone": {
						"type": "string"
					}
				},
				"additionalProperties": false,
				"minProperties": 1
			},
			"customer_note": {
				"type": "string"
			},
			"line_items": {
				"type": "array",
				"description": "Product lines. A variation uses its own ID as product_id. The price is the current price of the product.",
				"minItems": 1,
				"items": {
					"type": "object",
					"properties": {
						"product_id": {
							"type": "integer",
							"minimum": 1
						},
						"quantity": {
							"type": "integer",
							"minimum": 1
						}
					},
					"required": [
						"product_id"
					],
					"additionalProperties": false
				}
			},
			"shipping_lines": {
				"type": "array",
				"minItems": 1,
				"items": {
					"type": "object",
					"properties": {
						"method_id": {
							"type": "string"
						},
						"method_title": {
							"type": "string"
						},
						"total": {
							"type": "string"
						}
					},
					"required": [
						"method_title"
					],
					"additionalProperties": false
				}
			}
		},
		"required": [
			"line_items"
		],
		"additionalProperties": false
	},
