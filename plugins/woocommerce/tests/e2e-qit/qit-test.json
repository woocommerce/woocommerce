{
    "name": "woocommerce/core-e2e",
    "description": "Complete WooCommerce Core E2E Test Suite for extension compatibility testing",
    "version": "1.0.0",
    "type": "woocommerce",
    "requires": {
        "plugins": ["woocommerce"],
        "php": "^8.0",
        "wordpress": "^6.5"
    },
    "test": {
        "phases": {
            "globalSetup": [
                "node bootstrap/qit-setup.js"
            ],
            "run": [
                "npx playwright test"
            ]
        },
        "config": {
            "main_domain": "SITE_URL",
            "workers": 1,
            "timeout": 120000
        }
    },
    "subpackages": {
        "woocommerce/checkout-blocks": {
            "description": "Checkout Blocks compatibility tests",
            "tags": ["checkout", "blocks", "critical"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/checkout/*block*.spec.js tests/checkout/checkout.spec.js"]
                }
            }
        },
        "woocommerce/cart-blocks": {
            "description": "Cart Blocks compatibility tests",
            "tags": ["cart", "blocks"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/cart/*block*.spec.js"]
                }
            }
        },
        "woocommerce/product-editor": {
            "description": "Product Editor compatibility tests",
            "tags": ["products", "editor"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/product-editor/*.spec.js tests/product/*.spec.js"]
                }
            }
        },
        "woocommerce/payments": {
            "description": "Payment gateway compatibility tests",
            "tags": ["payments", "checkout"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/payments/*.spec.js tests/checkout/*payment*.spec.js"]
                }
            }
        },
        "woocommerce/shopper-flows": {
            "description": "Complete shopper flow tests",
            "tags": ["shopper", "critical"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/shopper/*.spec.js"]
                }
            }
        },
        "woocommerce/merchant-flows": {
            "description": "Merchant and admin tests",
            "tags": ["merchant", "admin"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/merchant/*.spec.js tests/admin/*.spec.js"]
                }
            }
        },
        "woocommerce/critical-flows": {
            "description": "Critical path tests (checkout, cart, my-account)",
            "tags": ["critical", "smoke"],
            "test": {
                "phases": {
                    "run": ["npx playwright test tests/checkout/checkout.spec.js tests/cart/cart.spec.js tests/my-account/*.spec.js"]
                }
            }
        }
    }
}