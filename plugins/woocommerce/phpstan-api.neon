# PHPStan configuration for the Code API (PHP 8.1+).
#
# src/Api/ and src/Internal/Api/ are excluded from phpstan.neon: that configuration
# pins phpVersion to 70400 for the rest of the plugin, and cannot parse the enums,
# named arguments, constructor property promotion and union types this code uses.
# The result is that the newest part of the codebase is the only part CI never
# type-checks. Analysing it needs a separate configuration with its own PHP version
# and its own baseline.
#
# The feature is guarded at runtime by src/Api/Infrastructure/Main.php, which requires
# PHP_VERSION_ID >= 80100, so nothing here has to run on 7.4.

includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	tmpDir: tmp/api
	level: 8
	phpVersion: 80100
	paths:
		- src/Api
		- src/Internal/Api
	excludePaths:
		# Written by ApiBuilder and marked DO NOT EDIT MANUALLY. An error here has to be
		# fixed in the generator, not in the file, and the baseline would churn on every
		# regeneration.
		- src/Internal/Api/Autogenerated
	bootstrapFiles:
		- vendor/autoload.php
	scanDirectories:
		- vendor/wordpress/abilities-api
		- packages/action-scheduler
		- ../../packages/php/woocommerce-analytics/src
	scanFiles:
		- php-stubs/wc-admin-feature-config.php
		- php-stubs/wc-constants.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Matches phpstan.neon, so this change only adds coverage rather than also
		# raising strictness. Dropping it is a sensible follow-up for new code.
		- identifier: missingType.iterableValue
	parallel:
		maximumNumberOfProcesses: 4
