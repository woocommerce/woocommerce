{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/admin.php?page=wc-admin",
	"login": true,
	"plugins": [ "woocommerce", "woocommerce-payments" ],
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true,
		"intl": true
	},
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"woocommerce_onboarding_profile": {
					"skipped": true
				},
				"blogname": "WooCommerce",
				"woocommerce_store_city": "Los Angeles",
				"woocommerce_store_address": "123 Main St",
				"woocommerce_store_postcode": "90038",
				"woocommerce_default_country": "United States",
				"woocommerce_currency": "USD",
				"woocommerce_weight_unit": "lbs",
				"woocommerce_dimension_unit": "in",
				"woocommerce_cheque_settings": {
					"enabled": "yes"
				},
				"woocommerce_allow_tracking": "no",
				"woocommerce_coming_soon": "no"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; $wp_rewrite->set_permalink_structure( '/%postname%/' ); include_once( ABSPATH . 'wp-admin/includes/plugin.php' ); deactivate_plugins( 'hello.php', 'hello-dolly' ); include_once( ABSPATH . 'wp-admin/includes/file.php' ); delete_plugins( [ 'hello.php', 'hello-dolly' ] );"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://github-proxy.com/proxy/?repo=woocommerce/woo-themes&branch=trunk&directory=purple"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/woocommerce/woocommerce/refs/heads/trunk/plugins/woocommerce/sample-data/sample_products.xml"
			}
		},
		{
			"step": "updateUserMeta",
			"meta": {
				"admin_color": "modern",
				"show_welcome_panel": 0
			},
			"userId": 1
		}
	]
}
