# Built CSS
/assets/css/*

# Built JS
/assets/js/*
/assets/client/*

# Behat/CLI Tests
tests/cli/installer
tests/cli/composer.phar
tests/cli/composer.lock
tests/cli/composer.json
tests/cli/vendor

# Unit Tests
/tests/bin/tmp
/tests/e2e/config/local-*.json
/tests/e2e/config/local.json
/tests/e2e/screenshots
/tests/e2e/plugins
.phpunit.result.cache

# Test translations
/i18n/languages/woocommerce*

# Packages — Composer-installed third parties by default (gitignored).
# Source packages compiled by @wordpress/build are allowlisted individually
# until upstream supports a configurable packagesDir. See packages/README.md.
/packages/*
!/packages/README.md
!/packages/core-dashboard-init
!/packages/core-dashboard-init/**
# ...but never the package's installed dependencies (the `**` above re-includes
# them, overriding the root .gitignore's node_modules rule).
/packages/core-dashboard-init/node_modules/

# Language files
i18n/languages/woocommerce.pot

# Environment files
.wp-env.override.json
