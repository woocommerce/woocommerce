{
	"extends": "@wordpress/stylelint-config/scss-stylistic",
	"plugins": [
		"@wordpress/theme/stylelint-plugins/no-token-fallback-values",
		"./bin/stylelint-plugins/motion.js"
	],
	"reportNeedlessDisables": true,
	"rules": {
		"plugin-wpds/no-token-fallback-values": true,
		"no-descending-specificity": null,
		"no-duplicate-selectors": null,
		"selector-class-pattern": null,
		"at-rule-empty-line-before": null,
		"at-rule-no-unknown": null,
		"comment-empty-line-before": null,
		"font-weight-notation": null,
		"rule-empty-line-before": null,
		"value-keyword-case": null,
		"@stylistic/declaration-colon-newline-after": null,
		"@stylistic/function-parentheses-space-inside": null,
		"@stylistic/function-comma-space-after": null,
		"@stylistic/indentation": null,
		"@stylistic/max-line-length": null,
		"length-zero-no-unit": [
			true,
			{ "ignoreFunctions": [ "calc", "var" ] }
		]
	},
	"overrides": [
		{
			"files": [
				"assets/js/blocks/cart/**/*.scss",
				"assets/js/blocks/checkout/**/*.scss",
				"assets/js/blocks/mini-cart/**/*.scss",
				"assets/js/blocks/cart-checkout-shared/**/*.scss",
				"assets/js/base/components/button/**/*.scss",
				"assets/js/base/components/drawer/**/*.scss",
				"assets/js/base/components/notice-banner/**/*.scss",
				"assets/js/base/components/snackbar-list/**/*.scss",
				"assets/js/base/components/loading-mask/**/*.scss",
				"assets/js/base/components/rolling-price/**/*.scss",
				"assets/js/base/components/cart-checkout/**/*.scss",
				"packages/public-api/blocks-components/**/*.scss",
				"assets/css/abstracts/_mixins.scss"
			],
			"rules": {
				"woocommerce/motion-safe": true,
				"woocommerce/motion-tokens": true
			}
		}
	]
}
