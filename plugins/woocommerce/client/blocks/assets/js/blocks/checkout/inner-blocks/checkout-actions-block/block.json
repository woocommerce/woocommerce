{
	"name": "woocommerce/checkout-actions-block",
	"title": "Actions",
	"description": "Place order button, with optional Terms and Conditions and Return to Cart links.",
	"category": "woocommerce",
	"supports": {
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"link": false,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			},
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"textAlign": true
			},
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			},
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"padding": true,
			"__experimentalDefaultControls": {
				"padding": true
			},
			"__experimentalSkipSerialization": true
		},
		"align": false,
		"html": false,
		"multiple": false,
		"reusable": false,
		"inserter": false,
		"lock": false
	},
	"selectors": {
		"root": ".wp-block-woocommerce-checkout-actions-block",
		"color": ".wp-block-woocommerce-checkout-actions-block .wc-block-components-checkout-place-order-button",
		"typography": ".wp-block-woocommerce-checkout-actions-block .wc-block-components-checkout-place-order-button",
		"border": ".wp-block-woocommerce-checkout-actions-block .wc-block-components-checkout-place-order-button",
		"spacing": ".wp-block-woocommerce-checkout-actions-block .wc-block-components-checkout-place-order-button"
	},
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		},
		"cartPageId": {
			"type": "number",
			"default": 0
		},
		"showReturnToCart": {
			"type": "boolean",
			"default": false
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"priceSeparator": {
			"type": "string",
			"default": "·"
		},
		"showTerms": {
			"type": "boolean"
		},
		"termsCheckbox": {
			"type": "boolean"
		},
		"termsText": {
			"type": "string"
		}
	},
	"styles": [
		{
			"name": "without-price",
			"label": "Hide Price",
			"isDefault": true
		},
		{
			"name": "with-price",
			"label": "Show Price"
		}
	],
	"parent": [ "woocommerce/checkout-fields-block" ],
	"textdomain": "woocommerce",
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3
}
