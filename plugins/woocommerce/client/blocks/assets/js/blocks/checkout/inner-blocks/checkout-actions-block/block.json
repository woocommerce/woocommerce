{
	"name": "woocommerce/checkout-actions-block",
	"title": "Actions",
	"description": "Place order button, with optional Terms and Conditions and Return to Cart links.",
	"category": "woocommerce",
	"supports": {
		"align": false,
		"html": false,
		"multiple": false,
		"reusable": false,
		"inserter": false,
		"lock": false
	},
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		},
		"cartPageId": {
			"type": "number",
			"default": 0
		},
		"showReturnToCart": {
			"type": "boolean",
			"default": false
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"priceSeparator": {
			"type": "string",
			"default": "·"
		},
		"showTerms": {
			"type": "boolean"
		},
		"termsCheckbox": {
			"type": "boolean"
		},
		"termsText": {
			"type": "string"
		}
	},
	"styles": [
		{
			"name": "without-price",
			"label": "Hide Price",
			"isDefault": true
		},
		{
			"name": "with-price",
			"label": "Show Price"
		}
	],
	"parent": [ "woocommerce/checkout-fields-block" ],
	"textdomain": "woocommerce",
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3
}
