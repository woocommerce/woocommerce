{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "woocommerce/shopper-collection-cart-button",
	"version": "1.0.0",
	"title": "Shopper Collection: Cart Button",
	"description": "Display a button that moves a saved item to the cart.",
	"category": "woocommerce-product-elements",
	"keywords": [ "WooCommerce", "Save for Later", "Wishlist", "Cart" ],
	"textdomain": "woocommerce",
	"ancestor": [ "woocommerce/shopper-collection" ],
	"attributes": {
		"text": {
			"type": "string"
		}
	},
	"supports": {
		"interactivity": true,
		"reusable": false,
		"color": {
			"text": true,
			"background": true,
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"radius": true,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalSelector": ".wc-block-shopper-collection-cart-button .wc-block-components-product-button__button"
	},
	"styles": [
		{
			"name": "fill",
			"label": "Fill",
			"isDefault": true
		},
		{
			"name": "outline",
			"label": "Outline"
		}
	],
	"viewScriptModule": "woocommerce/shopper-collection-cart-button",
	"style": "file:../woocommerce/shopper-collection-cart-button-style.css"
}
