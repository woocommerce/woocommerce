	"apiVersion": 3,
	"textdomain": "woocommerce",
	"attributes": {
		"textAlign": {
			"type": "string"
		}
	},
	"supports": {
		"align": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"link": true
		},
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
