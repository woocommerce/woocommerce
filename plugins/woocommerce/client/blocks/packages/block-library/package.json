{
	"name": "@woocommerce-block-library/block-library",
	"private": true,
	"version": "1.0.0",
	"license": "GPL-2.0-or-later",
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./build/*": "./build/*",
		"./build-module/*": "./build-module/*",
		"./package.json": "./package.json"
	},
	"wpScript": true,
	"wpScriptModuleExports": {
		"./product-gallery/view": "./build-module/product-gallery/frontend.mjs",
		"./product-gallery-large-image/view": "./build-module/product-gallery-large-image/frontend.mjs"
	},
	"dependencies": {
		"@wordpress/icons": "wp-bundled"
	},
	"devDependencies": {
		"clsx": "2.1.1",
		"@wordpress/data": "wp-min",
		"@wordpress/core-data": "wp-min"
	}
}
