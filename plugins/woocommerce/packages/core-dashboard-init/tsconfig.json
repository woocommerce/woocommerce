{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"emitDeclarationOnly": false,
		"rootDir": ".",
		"jsx": "react-jsx"
	},
	"include": [
		"**/*.ts",
		"**/*.tsx"
	],
	"exclude": [
		"**/test/**",
		"**/build/**",
		"**/build-types/**"
	]
}
