	"extends": [ "config:recommended" ],
	"packageRules": [
		{
			"matchDepTypes": [ "pnpm.catalog.tooling" ],
			"rangeStrategy": "bump"
		},
		{
			"matchDepTypes": [ "pnpm.catalog.tooling" ],
