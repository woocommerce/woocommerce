{
	"name": "code-analyzer",
	"version": "1.0.0",
	"description": "A tool to analyze code changes in WooCommerce Monorepo.",
	"author": "Automattic",
	"homepage": "https://github.com/woocommerce/woocommerce",
	"license": "GPL-2.0-or-later",
	"repository": "woocommerce/woocommerce",
	"private": true,
	"types": "dist/index.d.ts",
	"scripts": {
		"analyzer": "node -r ts-node/register ./src/commands/analyzer/index.ts",
		"lint": "eslint .",
		"test": "pnpm test:js",
		"test:js": "wp-scripts test-unit-js"
	},
	"dependencies": {
		"@actions/core": "^2.0.3",
		"@commander-js/extra-typings": "^10.0.3",
		"@oclif/core": "^2.15.0",
		"@tsconfig/node16": "^1.0.4",
		"@woocommerce/monorepo-utils": "workspace:*",
		"commander": "^9.5.0",
		"dotenv": "^10.0.0",
		"simple-git": "^3.21.0"
	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"@vitest/coverage-v8": "catalog:tooling",
		"@woocommerce/eslint-config": "workspace:*",
		"@woocommerce/eslint-plugin": "workspace:*",
		"@wordpress/scripts": "catalog:tooling",
		"eslint": "^10.0.0",
		"ts-node": "^10.9.2",
		"tslib": "^2.6.2",
		"typescript": "5.7.x",
		"vite": "catalog:tooling",
		"vitest": "catalog:tooling",
		"@woocommerce/internal-js-tests": "workspace:*"
	},
	"engines": {
		"node": "^24.15.0"
	},
	"config": {
		"ci": {
			"lint": {
				"command": "lint",
				"changes": "src/**/*.ts"
			},
			"tests": [
				{
					"name": "JavaScript",
					"command": "test:js",
					"changes": [
						"vitest.config.mjs",
						"tsconfig.json",
						"src/**/*.ts"
					],
					"events": [
						"pull_request",
						"push"
					]
				}
			]
		}
	}
}
