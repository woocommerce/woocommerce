{
	"name": "@woocommerce/monorepo-utils",
	"version": "0.0.1",
	"description": "WooCommerce Monorepo utility tooling.",
	"author": "Automattic",
	"homepage": "https://github.com/woocommerce/woocommerce",
	"license": "GPL-2.0-or-later",
	"repository": "woocommerce/woocommerce",
	"private": true,
	"bin": {
		"monorepo-utils": "./bin/run"
	},
	"main": "dist/index.js",
	"files": [
		"bin",
		"dist",
		"fonts"
	],
	"scripts": {
		"build": "webpack --config webpack.config.js && replace '\r\n' '\n' fonts/Standard.flf",
		"lint": "eslint .",
		"start": "webpack --config webpack.config.js --watch",
		"test": "pnpm test:js",
		"test:js": "jest"
	},
	"dependencies": {
		"@actions/core": "^2.0.3",
		"@commander-js/extra-typings": "^10.0.3",
		"@octokit/graphql": "4.8.0",
		"@octokit/graphql-schema": "^14.45.1",
		"@octokit/types": "^9.3.2",
		"@slack/web-api": "^6.10.0",
		"@types/cli-table": "^0.3.4",
		"chalk": "^4.1.2",
		"cli-table": "^0.3.11",
		"commander": "^10.0.1",
		"dotenv": "^10.0.0",
		"figlet": "^1.7.0",
		"glob": "^10.3.10",
		"graphql": "^16.8.1",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.3.1",
		"luxon": "^3.4.4",
		"minimatch": "^9.0.3",
		"octokit": "^3.1.2",
		"ora": "^5.4.1",
		"promptly": "^3.2.0",
		"semver": "^7.5.4",
		"simple-git": "^3.21.0"
	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"@vitest/coverage-v8": "catalog:tooling",
		"@woocommerce/eslint-config": "workspace:*",
		"@woocommerce/eslint-plugin": "workspace:*",
		"@wordpress/scripts": "catalog:tooling",
		"copy-webpack-plugin": "13.0.x",
		"eslint": "^10.0.0",
		"replace": "^1.2.2",
		"ts-loader": "9.5.x",
		"typescript": "5.7.x",
		"vite": "catalog:tooling",
		"vitest": "catalog:tooling",
		"webpack": "catalog:tooling",
		"webpack-cli": "5.1.x",
		"@woocommerce/internal-js-tests": "workspace:*"
	},
	"engines": {
		"node": "^24.15.0"
	},
	"config": {
		"ci": {
			"lint": {
				"command": "lint",
				"changes": "src/**/*.ts"
			},
			"tests": [
				{
					"name": "JavaScript",
					"command": "test:js",
					"changes": [
						"jest.config.js",
						"tsconfig.json",
						"src/**/*.ts"
					],
					"events": [
						"pull_request",
						"push"
					]
				}
			]
		}
	}
}
