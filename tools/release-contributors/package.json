{
	"name": "release-contributors",
	"version": "0.0.1",
	"description": "Generate a WooCommerce release contributors list",
	"scripts": {
		"lint": "tsc --noEmit",
		"release-contributors": "node -r ts-node/register ./index.ts"
	},
	"author": "Automattic",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^24.15.0"
	},
	"devDependencies": {
		"@tsconfig/node16": "^1.0.4",
		"@types/ejs": "^3.1.5",
		"@types/lodash.shuffle": "^4.2.9",
		"@types/node": "^24.1.0",
		"@types/semver": "^7.5.6",
		"typescript": "5.7.x"
	},
	"dependencies": {
		"@commander-js/extra-typings": "^0.1.0",
		"@octokit/rest": "^19.0.13",
		"@woocommerce/monorepo-utils": "workspace:*",
		"commander": "9.4.0",
		"dotenv": "^15.0.1",
		"ejs": "^3.1.9",
		"lodash.shuffle": "^4.2.0",
		"semver": "^7.5.4",
		"ts-node": "^10.9.2"
	},
	"config": {
		"ci": {
			"lint": {
				"command": "lint",
				"changes": [
					"index.ts",
					"lib/**/*.ts"
				]
			}
		}
	}
}
