{
  "name": "wc-vite-proto",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-blocks.mjs && node build-admin.mjs",
    "build:blocks": "node build-blocks.mjs",
    "build:admin": "node build-admin.mjs",
    "watch:blocks": "node watch.mjs blocks ../../plugins/woocommerce/assets/client/blocks",
    "watch:admin": "node watch.mjs admin ../../plugins/woocommerce/assets/client/admin",
    "dev:admin": "vite --config dev/vite.config.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "rolldown": "1.2.19",
    "sass-embedded": "^1.100.0",
    "vite": "8.3.8"
  }
}
