{
	"compilerOptions": {
		"declaration": true,
		"importHelpers": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"typeRoots": [
			"./node_modules/@types"
		],
		"skipLibCheck": true
	},
	"ts-node": {
		"esm": false
	},
	"include": [
		"src/**/*"
	]
}
