{
	"name": "monorepo-merge",
	"version": "0.0.0",
	"private": true,
	"description": "A tool for merging repositories into the WooCommerce Monorepo.",
	"author": "Automattic",
	"bin": {
		"monorepo-merge": "./bin/monorepo-merge.mjs"
	},
	"homepage": "https://github.com/woocommerce/woocommerce",
	"license": "GPL-2.0-or-later",
	"repository": "woocommerce/woocommerce",
	"scripts": {
		"lint": "eslint .",
		"posttest": "pnpm lint",
		"test": "node --test"
	},
	"devDependencies": {
		"@woocommerce/eslint-config": "workspace:*",
		"eslint": "^10.0.0"
	},
	"engines": {
		"node": "^24.15.0"
	},
	"config": {
		"ci": {
			"lint": {
				"command": "lint",
				"changes": [
					"bin/**",
					"src/**",
					"test/**",
					"eslint.config.mjs",
					"package.json"
				]
			},
			"tests": [
				{
					"name": "JavaScript",
					"command": "test",
					"changes": [
						"bin/**",
						"src/**",
						"test/**",
						"package.json"
					],
					"events": [
						"pull_request",
						"push"
					]
				}
			]
		}
	}
}
